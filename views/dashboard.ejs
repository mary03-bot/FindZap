<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FindZap - Dashboard</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <div class="dashboard-container">
        <div class="dashboard-card">
            <h1 class="dashboard-title">
                ¡Bienvenido a FindZap, <%= userName %>! 🚀
            </h1>
            <p class="dashboard-subtitle">Panel de control y gestión multitenant de tu inventario y préstamos.</p>
            
            <div class="dashboard-meta">
                Business ID Activo: <code><%= businessId %></code>
            </div>
            
            <div class="dashboard-actions">
                <a href="/tienda" class="btn-dashboard-solid">Ver Tienda / Inventario</a>
                <a href="/prestamos" class="btn-dashboard-outline">Gestionar Préstamos</a>
            </div>
        </div>
    </div>
</body>
</html>