<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FindZap - Tienda y Caja</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <div class="dashboard-container" style="max-width: 1100px;">
        <!-- Cabecera -->
        <div class="dashboard-card" style="margin-bottom: 2rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                <div>
                    <h1 class="dashboard-title">Caja y Tienda 🛒</h1>
                    <p class="dashboard-subtitle">Control de ingresos, egresos y clientes fiados para <strong><%= userName %></strong></p>
                </div>
                <div>
                    <a href="/dashboard" class="btn-dashboard-outline">Volver al Dashboard</a>
                </div>
            </div>
        </div>

        <div class="tienda-grid">
            <!-- Columna Izquierda: Registro de Transacciones y Caja Central -->
            <div>
                <!-- Formulario Nueva Transacción -->
                <div class="dashboard-card" style="margin-bottom: 1.5rem;">
                    <h2 style="font-size: 1.2rem; color: var(--cyan-neon); margin-bottom: 1rem;">Registrar Movimiento</h2>
                    <form action="/tienda/transaccion" method="POST">
                        <div class="form-group">
                            <label for="tipo">Tipo de Movimiento</label>
                            <select id="tipo" name="tipo" class="form-group input" style="width: 100%; padding: 0.8rem; background: var(--fondo-principal); color: var(--texto-principal); border-radius: 8px; border: 1px solid rgba(255,255,255,0.1);">
                                <option value="ingreso">Ingreso (Venta)</option>
                                <option value="egreso">Egreso (Pago a Proveedor / Gasto)</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="categoria">Categoría / Método</label>
                            <select id="categoria" name="categoria" class="form-group input" style="width: 100%; padding: 0.8rem; background: var(--fondo-principal); color: var(--texto-principal); border-radius: 8px; border: 1px solid rgba(255,255,255,0.1);">
                                <option value="efectivo">Efectivo</option>
                                <option value="nequi">Nequi</option>
                                <option value="llave">Llave</option>
                                <option value="proveedor">Proveedor</option>
                                <option value="otro">Otro</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="monto">Monto ($)</label>
                            <input type="number" step="any" id="monto" name="monto" placeholder="0.00" required>
                        </div>

                        <div class="form-group">
                            <label for="descripcion">Descripción</label>
                            <input type="text" id="descripcion" name="descripcion" placeholder="Ej. Venta de mercancía o pago factura X" required>
                        </div>

                        <button type="submit" class="btn-primary">Guardar Movimiento</button>
                    </form>
                </div>

                <!-- Caja Central & Totales -->
                <div class="dashboard-card">
                    <h2 style="font-size: 1.2rem; color: var(--morado-principal); margin-bottom: 1rem;">Caja Central</h2>
                    
                    <div class="caja-resumen">
                        <div class="caja-item">
                            <h3>Ingresos</h3>
                            <p style="color: #34d399;">$<%= totalIngresos.toLocaleString() %></p>
                        </div>
                        <div class="caja-item">
                            <h3>Egresos</h3>
                            <p style="color: var(--magenta-neon);">$<%= totalEgresos.toLocaleString() %></p>
                        </div>
                        <div class="caja-item">
                            <h3>Balance</h3>
                            <p>$<%= balanceTotal.toLocaleString() %></p>
                        </div>
                    </div>

                    <!-- Filtros por mes/año -->
                    <form action="/tienda" method="GET" style="display: flex; gap: 0.5rem; margin-bottom: 1.5rem; flex-wrap: wrap;">
                        <input type="number" name="mes" placeholder="Mes (1-12)" value="<%= filtroMes %>" style="flex: 1; padding: 0.5rem; background: var(--fondo-principal); color: white; border: 1px solid rgba(255,255,255,0.1); border-radius: 6px;">
                        <input type="number" name="anio" placeholder="Año (Ej. 2026)" value="<%= filtroAnio %>" style="flex: 1; padding: 0.5rem; background: var(--fondo-principal); color: white; border: 1px solid rgba(255,255,255,0.1); border-radius: 6px;">
                        <button type="submit" style="padding: 0.5rem 1rem; background: var(--cyan-neon); border: none; border-radius: 6px; font-weight: bold; cursor: pointer;">Filtrar</button>
                    </form>

                    <h3 style="font-size: 1rem; margin-bottom: 0.5rem; color: #cbd5e1;">Historial de Caja</h3>
                    <div style="max-height: 250px; overflow-y: auto;">
                        <table>
                            <thead>
                                <tr>
                                    <th>Fecha / Desc.</th>
                                    <th>Cat.</th>
                                    <th>Monto</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (transacciones.length === 0) { %>
                                    <tr><td colspan="4" style="text-align: center; color: #94a3b8;">No hay movimientos registrados.</td></tr>
                                <% } else { %>
                                    <% transacciones.forEach(t => { %>
                                        <tr>
                                            <td>
                                                <div style="font-weight: 600;"><%= t.descripcion %></div>
                                                <div style="font-size: 0.75rem; color: #94a3b8;"><%= new Date(t.fecha).toLocaleDateString() %></div>
                                            </td>
                                            <td><span style="text-transform: uppercase; font-size: 0.75rem;"><%= t.categoria %></span></td>
                                            <td style="color: <%= t.tipo === 'ingreso' ? '#34d399' : 'var(--magenta-neon)' %>;">
                                                <%= t.tipo === 'ingreso' ? '+' : '-' %>$<%= t.monto.toLocaleString() %>
                                            </td>
                                            <td>
                                                <form action="/tienda/transaccion/eliminar/<%= t._id %>" method="POST" style="display:inline;">
                                                    <button type="submit" style="background: none; border: none; color: var(--magenta-neon); cursor: pointer; font-size: 0.8rem;">Eliminar</button>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Columna Derecha: Clientes Fiados y Estado de Cuenta -->
            <div>
                <!-- Registrar Cliente Fiado -->
                <div class="dashboard-card" style="margin-bottom: 1.5rem;">
                    <h2 style="font-size: 1.2rem; color: var(--cyan-neon); margin-bottom: 1rem;">Nuevo Cliente Fiado</h2>
                    <form action="/tienda/cliente" method="POST">
                        <div class="form-group">
                            <label for="nombreCliente">Nombre del Cliente</label>
                            <input type="text" id="nombreCliente" name="nombreCliente" placeholder="Ej. Carlos Pérez" required>
                        </div>
                        <div class="form-group">
                            <label for="telefono">Teléfono (Opcional)</label>
                            <input type="text" id="telefono" name="telefono" placeholder="3001234567">
                        </div>
                        <button type="submit" class="btn-primary" style="background: linear-gradient(135deg, var(--cyan-neon), #0284c7);">Crear Cliente</button>
                    </form>
                </div>

                <!-- Lista de Clientes y Estado -->
                <div class="dashboard-card">
                    <h2 style="font-size: 1.2rem; color: var(--morado-principal); margin-bottom: 1rem;">Estado de Cuentas (Fiados)</h2>
                    
                    <div style="max-height: 500px; overflow-y: auto; display: flex; flex-direction: column; gap: 1rem;">
                        <% if (clientes.length === 0) { %>
                            <p style="color: #94a3b8; text-align: center;">No hay clientes registrados.</p>
                        <% } else { %>
                            <% clientes.forEach(c => { %>
                                <div style="background: var(--fondo-principal); padding: 1rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.06);">
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                                        <strong><%= c.nombreCliente %></strong>
                                        <span class="<%= c.estado === 'debiendo' ? 'badge-debiendo' : 'badge-nodebiendo' %>">
                                            <%= c.estado.toUpperCase() %>: $<%= c.saldoActual.toLocaleString() %>
                                        </span>
                                    </div>

                                    <!-- Formulario para agregar Fiado o Abono al cliente -->
                                    <form action="/tienda/cliente/<%= c._id %>/movimiento" method="POST" style="display: grid; grid-template-columns: 1fr 1fr 2fr auto; gap: 0.4rem; margin-bottom: 0.8rem; align-items: center;">
                                        <select name="tipo" style="padding: 0.4rem; background: var(--fondo-tarjetas); color: white; border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; font-size: 0.8rem;">
                                            <option value="fiado">Fiado (+)</option>
                                            <option value="abono">Abono (-)</option>
                                        </select>
                                        <input type="number" name="monto" placeholder="Monto" required style="padding: 0.4rem; background: var(--fondo-tarjetas); color: white; border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; font-size: 0.8rem;">
                                        <input type="text" name="descripcion" placeholder="Descripción" required style="padding: 0.4rem; background: var(--fondo-tarjetas); color: white; border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; font-size: 0.8rem;">
                                        <button type="submit" style="padding: 0.4rem 0.8rem; background: var(--morado-principal); color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 0.8rem;">+</button>
                                    </form>

                                    <!-- Historial de movimientos del cliente -->
                                    <details style="font-size: 0.8rem; color: #94a3b8;">
                                        <summary style="cursor: pointer; color: var(--cyan-neon);">Ver historial (<%= c.movimientos.length %> movimientos)</summary>
                                        <div style="margin-top: 0.5rem; display: flex; flex-direction: column; gap: 0.3rem;">
                                            <% if (c.movimientos.length === 0) { %>
                                                <span>Sin movimientos.</span>
                                            <% } else { %>
                                                <% c.movimientos.forEach(m => { %>
                                                    <div style="display: flex; justify-content: space-between; background: rgba(255,255,255,0.02); padding: 0.3rem 0.5rem; border-radius: 4px;">
                                                        <span><%= new Date(m.fecha).toLocaleDateString() %> - <%= m.descripcion %> (<%= m.tipo %>: $<%= m.monto.toLocaleString() %>)</span>
                                                        <form action="/tienda/cliente/<%= c._id %>/movimiento/eliminar/<%= m._id %>" method="POST" style="display:inline;">
                                                            <button type="submit" style="background:none; border:none; color:var(--magenta-neon); cursor:pointer;">×</button>
                                                        </form>
                                                    </div>
                                                <% }) %>
                                            <% } %>
                                        </div>
                                    </details>
                                </div>
                            <% }) %>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>