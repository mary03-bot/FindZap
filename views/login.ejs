<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FindZap - Iniciar Sesión</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <div class="auth-card">
        <h1>FindZap</h1>

        <% if (alerta) { %>
            <div class="alerta-error"><%= alerta %></div>
        <% } %>

        <form action="/login" method="POST">
            <div class="form-group">
                <label for="correo">Correo electrónico</label>
                <input type="email" id="correo" name="correo" placeholder="ejemplo@negocio.com" required>
            </div>
            
            <div class="form-group">
                <label for="password">Contraseña</label>
                <input type="password" id="password" name="password" placeholder="••••••••" required>
            </div>
            
            <button type="submit" class="btn-primary">Entrar</button>
        </form>

        <a href="/register" class="auth-link">¿Aún no tienes cuenta? <span>Registra tu negocio</span></a>
    </div>
</body>
</html>